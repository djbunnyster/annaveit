---
import prices from '../data/prices.json';
import Icon from './Icon.astro';
import { tg } from '../lib/links';
---
<section class="price" id="price">
  <div class="wrap">
    <h2 class="price__h">Стоимость</h2>
    <ol class="price__list">
      {prices.items.map((p) => (
        <li class:list={['price__row', { 'price__row--hl': p.badge }]} data-reveal>
          <div class="price__name">
            <h3>{p.name}{p.badge && <em class="price__badge">{p.badge.toLowerCase()}</em>}</h3>
            <p>{p.desc}</p>
          </div>
          <p class="price__val">{p.price}</p>
        </li>
      ))}
    </ol>
    <ul class="price__terms">
      {prices.conditions.map((c) => <li>{c}</li>)}
    </ul>
    <div class="price__cta" data-hide-float>
      <p class="price__ask">Пришлите ссылку на товар. Назову точную цену и срок.</p>
      <a class="btn" href={tg} target="_blank" rel="noopener" data-magnetic><Icon name="tg" />Отправить ссылку</a>
    </div>
  </div>
</section>

<style>
  /* Тёплый латте вместо чёрного (слово владельца: «чёрное на чёрном»): блок цен выделен тоном, а не темнотой */
  .price { background: #DDCFC0; color: var(--ink); padding-block: clamp(96px, 12vw, 180px); }
  .price__h em { color: var(--mocha); }
  .price__list { list-style: none; margin: clamp(48px, 6vw, 88px) 0 0; padding: 0; }
  .price__row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 24px 48px; align-items: baseline; padding-block: clamp(26px, 3vw, 40px); border-top: 1px solid rgba(35, 30, 27, .16); }
  .price__row h3 { display: flex; align-items: center; flex-wrap: wrap; gap: 14px; font-size: clamp(30px, 3.4vw, 52px); }
  .price__row p { margin-top: 10px; color: var(--ink-2); max-width: 46ch; }
  .price__badge { font: 500 italic max(15px, .62em)/1 var(--serif); color: var(--taupe); }
  /* Главный товар — тёмной панелью: глаз находит «под ключ» первым */
  .price__row--hl { background: var(--mocha); color: var(--paper); border-radius: 20px; padding-inline: clamp(22px, 3vw, 44px); border-top-color: transparent; margin-block: 8px; }
  .price__row--hl + .price__row { border-top-color: transparent; }
  .price__row--hl .price__name p { color: rgba(245, 241, 235, .72) !important; font-size: 15px; }
  .price__row--hl .price__val { color: var(--paper) !important; }
  .price__row--hl .price__badge { color: var(--sand); }
  .price__val { font: 500 clamp(40px, 5vw, 80px)/1 var(--serif); font-variant-numeric: lining-nums; white-space: nowrap; color: var(--ink) !important; margin: 0 !important; }
  .price__terms { list-style: none; margin: 0; padding: 28px 0 0; border-top: 1px solid rgba(35, 30, 27, .16); display: flex; flex-wrap: wrap; gap: 12px 40px; color: var(--mocha); font-weight: 600; }
  .price__cta { margin-top: clamp(56px, 7vw, 96px); display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px; padding: clamp(28px, 3vw, 44px); border-radius: 20px; background: var(--paper); }
  .price__ask { font: 500 italic clamp(26px, 2.6vw, 40px)/1.15 var(--serif); max-width: 24ch; }
  @media (max-width: 640px) {
    .price__row { grid-template-columns: 1fr; }
  }
</style>
