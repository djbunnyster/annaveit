---
// Согласие на cookie и Яндекс Метрика: счётчик грузится только после «Разрешить».
// Схема та же, что у смуззИИ (frontend/components/analytics/yandex-metrica.tsx).
import site from '../data/site.json';
const home = import.meta.env.BASE_URL;
---
<div class="consent" data-consent data-metrika={site.metrika} data-host={new URL(home, Astro.site).hostname} hidden>
  <p>Чтобы понимать, какие работы смотрят, я веду статистику в Яндекс Метрике: она считает посещения и записывает действия на странице. Для этого нужны cookie. <a class="link-u" href={`${home}privacy/`}>Подробнее</a></p>
  <div class="consent__btns">
    <button class="btn consent__btn" type="button" data-consent-yes>Разрешить</button>
    <button class="btn btn--line consent__btn" type="button" data-consent-no>Без статистики</button>
  </div>
</div>

<script>
  const KEY = 'av-consent';
  const bar = document.querySelector<HTMLElement>('[data-consent]');

  const read = (): boolean | null => {
    try { const v = localStorage.getItem(KEY); return v === null ? null : v === 'yes'; } catch { return null; }
  };
  const write = (yes: boolean) => { try { localStorage.setItem(KEY, yes ? 'yes' : 'no'); } catch { /* приватный режим */ } };

  // Кабинет Метрики открыл страницу в своём фрейме (Вебвизор, карта кликов) — это не посетитель
  const inMetrikaFrame = () => {
    try { return window.top !== window.self && /^metri[ck]a\.yandex\.(ru|com)$/.test(new URL(document.referrer).hostname); }
    catch { return false; }
  };

  let loaded = false;
  const load = () => {
    const id = Number(bar?.dataset.metrika);
    // Только на боевом домене и не у автоматических браузеров (наши проверки)
    if (loaded || !id || location.hostname.replace(/^www\./, '') !== bar?.dataset.host) return;
    if (navigator.webdriver) return;
    loaded = true;
    const w = window as unknown as { ym?: ((...a: unknown[]) => void) & { a?: unknown[][]; l?: number } };
    w.ym = w.ym || Object.assign((...a: unknown[]) => { (w.ym!.a = w.ym!.a || []).push(a); }, { l: Date.now() });
    const s = document.createElement('script');
    s.async = true;
    s.src = 'https://mc.yandex.ru/metrika/tag.js';
    document.head.appendChild(s);
    w.ym(id, 'init', { clickmap: true, trackLinks: true, accurateTrackBounce: true, webvisor: true });
  };

  const choice = read();
  if (choice || inMetrikaFrame()) load();
  if (choice === null && bar && !inMetrikaFrame()) {
    // На телефоне баннер закрыл бы кнопки первого экрана — ждём, пока человек пролистает его (как кнопка Telegram)
    const show = () => { bar.hidden = false; };
    if (!matchMedia('(max-width: 900px)').matches) setTimeout(show, 1200);
    else {
      const onScroll = () => { if (scrollY > innerHeight * 0.8) { removeEventListener('scroll', onScroll); show(); } };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  }

  bar?.querySelector('[data-consent-yes]')?.addEventListener('click', () => { write(true); bar.hidden = true; load(); });
  bar?.querySelector('[data-consent-no]')?.addEventListener('click', () => {
    write(false); bar.hidden = true;
    if (loaded) location.reload(); // отозвала согласие — уже загруженный счётчик выгружаем перезагрузкой
  });
  document.addEventListener('click', (e) => {
    if ((e.target as Element).closest('[data-consent-open]') && bar) bar.hidden = false;
  });
</script>

<style>
  .consent {
    /* На компьютере — правый угол: слева на первом экране главная кнопка «Написать в Telegram» */
    position: fixed; z-index: 70; right: 24px; bottom: 24px;
    max-width: 420px; padding: 20px 22px; border-radius: 18px; display: grid; gap: 16px;
    background: var(--paper); color: var(--ink); font-size: 15px; line-height: 1.5;
    box-shadow: 0 24px 60px -24px rgba(35, 30, 27, .5), 0 0 0 1px var(--line);
  }
  .consent a { font-weight: 600; }
  .consent__btns { display: flex; flex-wrap: wrap; gap: 8px; }
  .consent__btn { height: 44px; padding: 0 20px; font-size: 15px; }
  /* На телефоне справа плавает кнопка Telegram — баннер её не закрывает */
  @media (max-width: 900px) { .consent { left: max(16px, env(safe-area-inset-left, 0px)); right: calc(92px + env(safe-area-inset-right, 0px)); bottom: calc(16px + env(safe-area-inset-bottom, 0px)); max-width: none; padding: 14px 16px; gap: 12px; font-size: 14px; }
    .consent__btns { gap: 6px; }
    .consent__btn { height: 40px; padding: 0 14px; font-size: 14px; } }
</style>
