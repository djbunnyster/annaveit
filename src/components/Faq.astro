---
import prices from '../data/prices.json';
import faq from '../data/faq.json';

// Ответы Аня правит в админке. «{цена: Строка прайса}» подставляет цену из прайса, чтобы ответ не разошёлся с таблицей.
// Строки с таким именем нет — сборка падает громко: молча подставить пустоту значило бы соврать в ответе.
const qa = faq.items.map((x) => ({
  q: x.q,
  a: x.a.replace(/\{цена:\s*([^}]+)\}/g, (_, name: string) => {
    const item = prices.items.find((p) => p.name === name.trim());
    if (!item) throw new Error(`Вопрос «${x.q}»: в прайсе нет строки «${name.trim()}»`);
    return item.price;
  }),
}));
---
<section class="faq" id="faq">
  <div class="wrap faq__in">
    <h2>Вопросы</h2>
    <div class="faq__list">
      {qa.map((x) => (
        <details class="qa">
          <summary><span>{x.q}</span><i aria-hidden="true"></i></summary>
          <div class="qa__a"><p>{x.a}</p></div>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: qa.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } })) })} />
</section>

<style>
  .faq { padding-block: clamp(96px, 12vw, 180px); }
  .faq__in { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(32px, 6vw, 110px); align-items: start; }
  .faq__list { border-top: 1px solid var(--line); }
  .qa { border-bottom: 1px solid var(--line); }
  .qa summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 26px 0; font: 500 clamp(22px, 2vw, 30px)/1.2 var(--serif); }
  .qa summary::-webkit-details-marker { display: none; }
  .qa summary i { position: relative; flex: none; width: 18px; height: 18px; }
  .qa summary i::before, .qa summary i::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: var(--ink); transition: rotate .4s var(--ease); }
  .qa summary i::after { rotate: 90deg; }
  .qa[open] summary i::after { rotate: 0deg; }
  .qa__a { padding: 0 0 28px; color: var(--ink-2); max-width: 60ch; }
  @media (max-width: 900px) { .faq__in { grid-template-columns: 1fr; } }
</style>
