---
// Свои линейные иконки сайта. Системные эмодзи на сайте не используем.
interface Props { name: 'tg' | 'mail' | 'arrow' | 'channel' | 'close' | 'prev' | 'next'; class?: string }
const { name, class: cls } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'tg' && <path d="M21.2 4.3 2.9 11.4c-.8.3-.8 1.4 0 1.7l4.5 1.6 1.7 5.3c.2.7 1.1.9 1.6.4l2.5-2.4 4.6 3.4c.6.5 1.5.1 1.7-.6l3-14.2c.2-.9-.6-1.6-1.3-1.3Z M7.4 14.7 18 7.6l-8.1 8.2" />}
  {name === 'mail' && <><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></>}
  {name === 'arrow' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {name === 'channel' && <><path d="M4 9.5v5a1 1 0 0 0 1 1h2l6 4.5V4L7 8.5H5a1 1 0 0 0-1 1Z" /><path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" /></>}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'prev' && <path d="M15 5l-7 7 7 7" />}
  {name === 'next' && <path d="M9 5l7 7-7 7" />}
</svg>
